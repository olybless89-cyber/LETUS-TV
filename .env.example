# Neon Postgres (written to .env.local by `neon deploy` / `neon env pull`)
# Pooled (-pooler host): app queries
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (no -pooler): used by Prisma for db push / migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Admin account (initial credentials, used by `npm run db:seed`)
ADMIN_EMAIL="admin@letustv.com"
ADMIN_PASSWORD="Changeme123!"
ADMIN_NAME="Letus TV Admin"

# Security
JWT_SECRET="generate-a-secure-random-secret-here"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM=""
CONTACT_EMAIL="hello@letustv.com"

# YouTube import
YOUTUBE_API_KEY=""

# Storage: "local" files are lost on redeploy on Fly; use S3 for production
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Public site URL (set at build time in fly.toml)
NEXT_PUBLIC_SITE_URL="https://letus-tv.fly.dev"

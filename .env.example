# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/letus_tv?schema=public"

# ── Admin (initial setup — used by the seed script) ─────
# These seed the initial administrator account. Never hard-code production credentials.
ADMIN_EMAIL="admin@letustv.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Letus TV Admin"

# ── Auth ──────────────────────────────────────────────────
# Secret used to sign admin session JWTs. Use a long random string in production.
JWT_SECRET="replace-with-a-long-random-secret"

# ── Site ──────────────────────────────────────────────────
# Public canonical origin (no trailing slash(a)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ── Storage (optional) ─────────────────────────────────
# Media uploads: "local" (dev only) or "s3" (production)
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION=""

# ── Analytics (optional) ───────────────────────────────
# Google Analytics / Tag Manager ID
NEXT_PUBLIC_GA_ID=""
